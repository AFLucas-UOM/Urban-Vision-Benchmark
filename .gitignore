# ============================================================
# Urban-Vision-Benchmark .gitignore
# Policy: track code, configs, docs, annotations and the numeric
# experimental record; keep raw images, model weights and heavy
# run media out of git (they stay on disk, nothing is deleted).
# ============================================================

# --- Local configuration / secrets ---------------------------
.env
.env.*
!.env.example
# Label Studio local databases hold session/auth state and must never be
# versioned. NOTE: Datasets/MTSD/LabelStudioShared/.../label_studio.sqlite3 was
# committed before this rule existed and is still tracked; untrack it with
# `git rm --cached` (see Full-Repository-Audit recommended actions).
label_studio.sqlite3
*.sqlite3

# --- Python environments and caches --------------------------
.venv/
venv/
env/
ENV/
__pycache__/
*.pyc
*.pytest_cache

# --- Jupyter -------------------------------------------------
.ipynb_checkpoints/

# --- Datasets ------------------------------------------------
# Raw images and heavy exports are not versioned. Small, irreplaceable
# metadata IS tracked: MDWD data.yaml / Roboflow READMEs and the
# MTSD Final-QA annotation JSONs.
Datasets/MDWD/*/train/
Datasets/MDWD/*/valid/
Datasets/MDWD/*/test/
Datasets/MTSD/GRP-*/
Datasets/MTSD/Annotations/GRP-*/Fiverr-Annotations/
# Prepared MTSD detection datasets (built by Prepare-MTSD-Detection-Dataset.ipynb);
# images/labels are regenerable from the tracked QA JSONs + prep_manifest.json,
# which stay tracked along with data.yaml.
Datasets/MTSD/Prepared/**/train/
Datasets/MTSD/Prepared/**/valid/
Datasets/MTSD/Prepared/**/test/
Datasets/MTSD/Prepared/_archive/
*.cache
# Timestamped safety copies made by update_annotation_paths.ps1 (the
# pre-migration content is already preserved in git history).
*.pre-migration-*.bak

# --- Model weights and checkpoints ---------------------------
# Pretrained weights in Models/ are re-downloadable; trained weights
# live in Results/MDWD-Runs/**/weights and W&B artifacts.
checkpoints/
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.weights

# --- Experiment outputs --------------------------------------
# W&B local run folders and Ultralytics scratch runs/ dirs are not
# versioned (mirrored to the W&B cloud project where relevant).
wandb/
runs/
mlruns/
# Heavy per-run media inside curated run archives; the numeric record
# (results.csv, args.yaml, *.json) stays tracked.
Results/MDWD-Runs/**/*.jpg
Results/MDWD-Runs/**/*.jpeg
Results/MDWD-Runs/**/*.png
Results/MTSD-Runs/**/*.jpg
Results/MTSD-Runs/**/*.jpeg
Results/MTSD-Runs/**/*.png
# Attribute-classification bulk artefacts (regenerable from the QA
# JSONs via mtsd_attr.data_manifest); metrics/reports/manifests are tracked.
Scripts/MTSD-Scripts/AttributeClassification/outputs/crops/

# --- GDPR redaction previews ---------------------------------
GDPR-Compliance-Preview/

# --- Logs and temporary files --------------------------------
# Executed notebook copies from the automation runner (regenerable; can be large when training notebooks run headlessly).
Scripts/Automation/executed/
*.log
logs/
tmp/
temp/
TEMP-*/
temp-*/
exports/
env_backups/

# --- OS and editor metadata ----------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
.claude/
# Local UVB launcher state (reserved for future opt-in recent-launch history)
.uvb_launcher_state.json
